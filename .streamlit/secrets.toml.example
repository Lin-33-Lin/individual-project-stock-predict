# 复制为 .streamlit/secrets.toml 后按需填写；不要提交到公开仓库。
# 本地运行：放在项目根目录的 .streamlit/secrets.toml
# 云端部署：粘贴到 Streamlit Cloud → App → Settings → Secrets

# 生成后端：auto / extractive / ollama / api
GEN_BACKEND = "auto"

# —— 云端 API（任何 OpenAI 兼容接口：DeepSeek、Moonshot、通义、OpenAI…）——
API_BASE = "https://api.deepseek.com/v1"
API_KEY = ""
API_MODEL = "deepseek-chat"

# —— 本地 Ollama（只有本机部署才用得上）——
OLLAMA_URL = "http://localhost:11434"
OLLAMA_MODEL = "qwen2.5:3b"

# 向量化后端：tfidf（默认，零依赖）/ hf（需 sentence-transformers）/ ollama
EMBED_BACKEND = "tfidf"
